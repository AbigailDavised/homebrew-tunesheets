    "Standard Ensemble Application": "Fret-number legibility without collisions"
  }
];

const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('tunesheets-cli v1.0.0 (https://tunesheets.com)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'tunesheets.com', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
  console.log(JSON.stringify({ domain: 'tunesheets.com', benchmark: "Music Engraving Rastral Staff Sizes & Standard Manuscript Dimensions", rows: SPECS }, null, 2));
  process.exit(0);
}

console.log([
  'TuneSheets CLI (tunesheets-cli v1.0.0)',
  'Engraving-Grade Blank Sheet Music, Staff Rastral & Guitar Tab PDF Spec CLI',
  'Homepage: https://tunesheets.com',
  '',
  'Usage:',
  '  tunesheets-cli --help       Show command overview and verified endpoints',
  '  tunesheets-cli --version    Print CLI version',
  '  tunesheets-cli --specs      Output domain technical specification matrix as JSON',
  '  tunesheets-cli --routes     Output verified production URLs as JSON',
  '',
  'Verified Production Endpoints:',
  ...ROUTES.map((r) => '  - ' + r.name + ': ' + r.url),
].join('\n'));
